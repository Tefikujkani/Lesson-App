# Required: Groq API key (free) — https://console.groq.com
GROQ_API_KEY=

# Optional Groq model overrides (defaults are current production IDs)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional TURN (recommended for voice across different networks)
# TURN_URLS=turn:your-turn-host:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Required: MongoDB connection string (Atlas or local)
MONGODB_URI=

# Required: secret used to sign login JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Google / Gmail sign-in (Web OAuth Client ID from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
